{
  "type": "rest",
  "name": "wasi",
  "description": "Conector WASI.co - Plataforma inmobiliaria colombiana",
  "baseUrl": "https://api.wasi.co/v1",
  "auth": {
    "type": "query",
    "params": {
      "wasi_key": "{{env.WASI_API_KEY}}"
    }
  },
  "headers": {
    "Content-Type": "application/json",
    "Accept": "application/json"
  }
}
