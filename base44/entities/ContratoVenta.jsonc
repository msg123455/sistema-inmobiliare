{
  "name": "ContratoVenta",
  "type": "object",
  "description": "Proceso de venta de un inmueble, desde la promesa de compraventa hasta la entrega. El estado avanza por un timeline de escrituraci\u00f3n.",
  "properties": {
    "propiedad_id": {
      "type": "string",
      "description": "ID de la Propiedad vendida"
    },
    "propiedad_titulo": {
      "type": "string",
      "description": "T\u00edtulo de la propiedad, desnormalizado"
    },
    "comprador_id": {
      "type": "string",
      "description": "ID del Contacto que act\u00faa como comprador"
    },
    "comprador_nombre": {
      "type": "string",
      "description": "Nombre del comprador, desnormalizado"
    },
    "propietario_id": {
      "type": "string",
      "description": "ID del Propietario vendedor"
    },
    "propietario_nombre": {
      "type": "string",
      "description": "Nombre del vendedor, desnormalizado"
    },
    "precio_venta": {
      "type": "number",
      "description": "Precio de venta pactado en COP"
    },
    "comision_pct": {
      "type": "number",
      "default": 3,
      "description": "Porcentaje de comisi\u00f3n de la inmobiliaria"
    },
    "valor_comision": {
      "type": "number",
      "description": "Valor de la comisi\u00f3n en COP, calculado sobre el precio de venta"
    },
    "forma_pago": {
      "type": "string",
      "enum": [
        "Contado",
        "Credito_hipotecario",
        "Leasing",
        "Mixto"
      ],
      "default": "Contado",
      "description": "Forma de pago acordada"
    },
    "entidad_financiera": {
      "type": "string",
      "description": "Banco o entidad que otorga el cr\u00e9dito, si aplica"
    },
    "arras": {
      "type": "number",
      "description": "Valor de las arras entregadas en COP"
    },
    "fecha_promesa": {
      "type": "string",
      "format": "date",
      "description": "Fecha de firma de la promesa de compraventa"
    },
    "fecha_escritura": {
      "type": "string",
      "format": "date",
      "description": "Fecha de firma de la escritura p\u00fablica"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Promesa",
        "Credito_en_estudio",
        "Aprobado",
        "Escritura",
        "Entregado",
        "Cancelado"
      ],
      "default": "Promesa",
      "description": "Etapa actual del proceso de venta"
    },
    "notas": {
      "type": "string",
      "description": "Notas internas del proceso"
    }
  },
  "required": [
    "propiedad_id",
    "comprador_id",
    "precio_venta"
  ]
}