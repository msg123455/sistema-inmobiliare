{
  "type": "object",
  "name": "Socio",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre del socio o inversionista"
    },
    "tipo": {
      "type": "string",
      "description": "Tipo de socio",
      "enum": [
        "Inversionista",
        "Comercial"
      ]
    },
    "email": {
      "type": "string",
      "description": "Email de contacto",
      "format": "email"
    },
    "porcentaje_participacion": {
      "type": "number",
      "description": "Porcentaje de participaci\u00f3n o commission en %"
    },
    "valvulas_financiadas": {
      "type": "number",
      "description": "Cantidad de v\u00e1lvulas financiadas (para inversionistas)",
      "default": 0
    },
    "clientes_referidos": {
      "type": "number",
      "description": "Cantidad de clientes referidos (para socios comerciales)",
      "default": 0
    },
    "activo": {
      "type": "boolean",
      "description": "Si el socio est\u00e1 activo",
      "default": true
    }
  },
  "required": [
    "nombre",
    "tipo",
    "email",
    "porcentaje_participacion"
  ]
}