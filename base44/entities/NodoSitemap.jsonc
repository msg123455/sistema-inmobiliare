{
  "type": "object",
  "name": "NodoSitemap",
  "properties": {
    "keyword": {
      "type": "string",
      "description": "Keyword objetivo de esta p\u00e1gina"
    },
    "page_type": {
      "type": "string",
      "description": "Nivel del nodo dentro del cluster de contenido",
      "enum": [
        "pillar",
        "secondary",
        "third",
        "blog"
      ],
      "default": "blog"
    },
    "url": {
      "type": "string",
      "description": "Ruta/slug propuesto para la p\u00e1gina"
    },
    "title_suggestion": {
      "type": "string",
      "description": "T\u00edtulo sugerido para la p\u00e1gina"
    },
    "intencion": {
      "type": "string",
      "description": "Intenci\u00f3n de b\u00fasqueda detectada",
      "enum": [
        "informacional",
        "transaccional",
        "comercial",
        "navegacional"
      ]
    },
    "cluster": {
      "type": "string",
      "description": "Keyword semilla que agrupa este cluster"
    },
    "prioridad": {
      "type": "number",
      "description": "Prioridad de producci\u00f3n 1-10",
      "default": 5
    },
    "research_data": {
      "type": "string",
      "description": "Investigaci\u00f3n del keyword serializada en JSON"
    },
    "estado": {
      "type": "string",
      "description": "Estado del nodo dentro del pipeline",
      "enum": [
        "draft",
        "researched",
        "generating",
        "pending_approval",
        "published"
      ],
      "default": "draft"
    }
  },
  "required": [
    "keyword"
  ]
}