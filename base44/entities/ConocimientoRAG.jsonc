{
  "type": "object",
  "name": "ConocimientoRAG",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo del chunk de conocimiento"
    },
    "contenido": {
      "type": "string",
      "description": "Contenido del chunk inyectado en el prompt"
    },
    "categoria": {
      "type": "string",
      "description": "Categor\u00eda del conocimiento",
      "enum": [
        "avatar",
        "principios",
        "frases",
        "conversaciones",
        "antideteccion",
        "base",
        "voz",
        "politicas",
        "tarifas",
        "documentos",
        "procesos",
        "mercado",
        "general"
      ]
    },
    "etapas": {
      "type": "string",
      "description": "Etapas donde aplica: todas, calentamiento, descubrimiento, calificacion, propuesta, cierre (separadas por coma)"
    },
    "agentes": {
      "type": "string",
      "description": "Agentes que reciben este chunk, separados por coma (ventas, cartera, mantenimiento...). 'todos' para todos. Sin esto, cartera recibia 4.5KB de psicologia de ventas en cada consulta de saldo."
    },
    "prioridad": {
      "type": "number",
      "description": "Prioridad de inyecci\u00f3n 1-10 (10 = m\u00e1s importante)",
      "default": 5
    },
    "origen": {
      "type": "string",
      "description": "Quien administra el chunk, por ejemplo seedBaseAgentes:v2 o negocio:manual"
    },
    "activo": {
      "type": "boolean",
      "description": "Si est\u00e1 activo se inyecta en el prompt",
      "default": true
    }
  },
  "required": []
}
