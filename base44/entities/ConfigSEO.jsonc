{
  "type": "object",
  "name": "ConfigSEO",
  "properties": {
    "clave": {
      "type": "string",
      "description": "Clave \u00fanica de configuraci\u00f3n (usar 'general')",
      "default": "general"
    },
    "nombre_inmobiliaria": {
      "type": "string",
      "description": "Nombre de la inmobiliaria para el contenido SEO"
    },
    "ciudad_principal": {
      "type": "string",
      "description": "Ciudad principal de operaci\u00f3n",
      "default": "Bogot\u00e1"
    },
    "zonas": {
      "type": "array",
      "description": "Barrios y zonas que maneja la inmobiliaria (universo de keywords)",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "website_url": {
      "type": "string",
      "description": "URL del sitio web (para construir slugs y enlaces internos)"
    },
    "whatsapp_numero": {
      "type": "string",
      "description": "N\u00famero de WhatsApp para los CTA del contenido"
    },
    "anos_experiencia": {
      "type": "string",
      "description": "A\u00f1os de trayectoria en el mercado"
    },
    "descripcion_marca": {
      "type": "string",
      "description": "Descripci\u00f3n de la empresa que se inyecta en los prompts"
    },
    "rango_venta_min": {
      "type": "number",
      "description": "Piso de precio en venta (COP)"
    },
    "rango_arriendo_min": {
      "type": "number",
      "description": "Piso de canon en arriendo (COP)"
    },
    "interlinks": {
      "type": "array",
      "description": "URLs internas disponibles para enlazado interno",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "activo": {
      "type": "boolean",
      "description": "Si el m\u00f3dulo SEO est\u00e1 activo",
      "default": true
    }
  },
  "required": [
    "clave"
  ]
}