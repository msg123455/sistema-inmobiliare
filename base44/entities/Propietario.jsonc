{
  "name": "Propietario",
  "type": "object",
  "description": "Propietario de uno o m\u00e1s inmuebles en administraci\u00f3n. Contraparte del arrendatario en el contrato de arriendo.",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre completo o raz\u00f3n social"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Natural",
        "Juridico"
      ],
      "default": "Natural",
      "description": "Persona natural o jur\u00eddica"
    },
    "email": {
      "type": "string",
      "description": "Correo electr\u00f3nico de contacto"
    },
    "telefono": {
      "type": "string",
      "description": "Tel\u00e9fono / WhatsApp de contacto"
    },
    "cedula_nit": {
      "type": "string",
      "description": "C\u00e9dula (natural) o NIT (jur\u00eddica)"
    },
    "ciudad": {
      "type": "string",
      "description": "Ciudad de residencia o domicilio fiscal"
    },
    "banco": {
      "type": "string",
      "description": "Banco para consignar el pago del canon"
    },
    "tipo_cuenta": {
      "type": "string",
      "enum": [
        "Ahorros",
        "Corriente"
      ],
      "default": "Ahorros",
      "description": "Tipo de cuenta bancaria"
    },
    "numero_cuenta": {
      "type": "string",
      "description": "N\u00famero de cuenta bancaria"
    },
    "porcentaje_administracion": {
      "type": "number",
      "default": 10,
      "description": "Porcentaje que cobra la inmobiliaria por administrar el inmueble"
    },
    "origen": {
      "type": "string",
      "description": "De donde salio el registro: 'agente:whatsapp', 'importacion' o 'manual'. Sirve para saber si los datos los dicto el cliente por chat o vienen de la operacion."
    },
    "notas": {
      "type": "string",
      "description": "Notas internas sobre el propietario"
    }
  },
  "required": [
    "nombre"
  ]
}