{
  "type": "object",
  "name": "EvaluacionChat",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "Telefono o chatId del lead cuya conversacion se evaluo (uno por lead, se refresca)"
    },
    "nombre_lead": {
      "type": "string",
      "description": "Nombre del lead capturado por Valentina, si lo tiene"
    },
    "canal": {
      "type": "string",
      "description": "Canal de la conversacion (whatsapp / telegram)"
    },
    "num_mensajes": {
      "type": "number",
      "description": "Cantidad de mensajes del historial al momento de evaluar (para no re-evaluar si no crecio)",
      "default": 0
    },
    "score_total": {
      "type": "number",
      "description": "Puntaje global 0 a 100 (promedio de las cuatro dimensiones)",
      "default": 0
    },
    "score_calificacion": {
      "type": "number",
      "description": "Que tan bien califico el lead y saco los datos clave (0 a 100)",
      "default": 0
    },
    "score_humanizacion": {
      "type": "number",
      "description": "Que tan humana sono, sin guiones largos ni lenguaje IA (0 a 100)",
      "default": 0
    },
    "score_rapidez": {
      "type": "number",
      "description": "Que tan directo avanzo sin preguntas inutiles (0 a 100)",
      "default": 0
    },
    "score_cierre": {
      "type": "number",
      "description": "Que tan bien cerro hacia la broker cuando debia (0 a 100)",
      "default": 0
    },
    "veredicto": {
      "type": "string",
      "description": "Resumen de una frase del desempeno de Valentina en esa conversacion"
    },
    "fortalezas": {
      "type": "array",
      "description": "Que hizo bien Valentina",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "errores": {
      "type": "array",
      "description": "Que hizo mal Valentina",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "lecciones": {
      "type": "array",
      "description": "Mejoras concretas sugeridas para el prompt de Valentina (Fase B las revisa y aprueba)",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "transcript": {
      "type": "string",
      "description": "La transcripcion exacta que el juez reviso (una linea por mensaje: Lead / Valentina)"
    },
    "anotaciones": {
      "type": "string",
      "description": "JSON con comentarios anclados por mensaje: [{ msg, tipo, comentario }]"
    },
    "estado": {
      "type": "string",
      "description": "Estado de las lecciones para Fase B (aprender). En Fase A quedan pendiente",
      "enum": [
        "pendiente",
        "aprobada",
        "rechazada",
        "aplicada"
      ],
      "default": "pendiente"
    },
    "modelo_juez": {
      "type": "string",
      "description": "Modelo que realizo la evaluacion (para transparencia)"
    },
    "fecha_evaluacion": {
      "type": "string",
      "description": "Fecha y hora ISO en que se corrio la evaluacion"
    }
  },
  "required": [
    "cliente_id"
  ]
}