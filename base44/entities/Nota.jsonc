{
  "type": "object",
  "name": "Nota",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente (referencia a Cliente)"
    },
    "texto": {
      "type": "string",
      "description": "Contenido de la nota"
    },
    "fecha_nota": {
      "type": "string",
      "description": "Fecha y hora de la nota",
      "format": "date-time"
    }
  },
  "required": [
    "cliente_id",
    "texto"
  ]
}