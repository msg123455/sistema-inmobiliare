{
  "type": "object",
  "name": "ProyeccionEscenario",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre del escenario de proyecci\u00f3n"
    },
    "modelo": {
      "type": "string",
      "description": "Tipo de modelo de crecimiento",
      "enum": [
        "Inversionista",
        "Socio_comercial"
      ]
    },
    "parametros": {
      "type": "object",
      "description": "Par\u00e1metros del escenario (JSON libre)",
      "additionalProperties": true
    },
    "resultados": {
      "type": "object",
      "description": "Resultados calculados (JSON con proyecciones)",
      "additionalProperties": true
    },
    "mes_inicio": {
      "type": "string",
      "description": "Mes de inicio de la proyecci\u00f3n",
      "format": "date"
    }
  },
  "required": [
    "nombre",
    "modelo"
  ]
}