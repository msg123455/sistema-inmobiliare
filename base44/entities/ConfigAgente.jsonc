{
  "type": "object",
  "name": "ConfigAgente",
  "properties": {
    "clave": {
      "type": "string",
      "description": "Clave \u00fanica (usar 'general')"
    },
    "nombre_agente": {
      "type": "string",
      "description": "Nombre del agente de IA",
      "default": "Valentina"
    },
    "nombre_inmobiliaria": {
      "type": "string",
      "description": "Nombre de la inmobiliaria"
    },
    "instrucciones_sistema": {
      "type": "string",
      "description": "System prompt con personalidad, flujo y reglas del agente"
    },
    "conocimiento_base": {
      "type": "array",
      "description": "FAQs, pol\u00edticas y datos que el agente debe conocer (RAG)",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "saludo_inicial": {
      "type": "string",
      "description": "Mensaje de saludo inicial. Usa {{nombre}}, {{agente}}, {{inmobiliaria}}"
    },
    "horario_inicio": {
      "type": "string",
      "description": "Hora inicio de atenci\u00f3n (HH:MM)",
      "default": "08:00"
    },
    "horario_fin": {
      "type": "string",
      "description": "Hora fin de atenci\u00f3n (HH:MM)",
      "default": "20:00"
    },
    "fuera_de_horario_mensaje": {
      "type": "string",
      "description": "Mensaje autom\u00e1tico fuera del horario de atenci\u00f3n"
    },
    "escalar_triggers": {
      "type": "array",
      "description": "Palabras clave que disparan escalaci\u00f3n a un humano",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "activo": {
      "type": "boolean",
      "description": "Si el agente responde autom\u00e1ticamente",
      "default": true
    },
    "demora_respuesta_min": {
      "type": "number",
      "description": "Minutos que espera el agente antes de responder (0 = al instante, m\u00e1s humano si es 2). Requiere el cron enviarPendientes corriendo.",
      "default": 0
    },
    "aprendizajes": {
      "type": "string",
      "description": "Bloque de reglas aprendidas y APROBADAS que se inyectan al prompt de Valentina (Fase B autoeducaci\u00f3n)"
    },
    "numero_notificaciones": {
      "type": "string",
      "description": "N\u00famero (WhatsApp, con c\u00f3digo de pa\u00eds, sin +) que recibe la notificaci\u00f3n de lead calificado. Si est\u00e1 vac\u00edo, se usa el tel\u00e9fono del broker asignado. NUNCA se env\u00eda al lead."
    },
    "telegram_notif_chat": {
      "type": "string",
      "description": "Chat ID de Telegram del equipo que recibe la notificaci\u00f3n de lead calificado. Si est\u00e1 configurado, tiene prioridad sobre WhatsApp (Telegram no tiene ventana de 24h). NUNCA se env\u00eda al chat del lead."
    },
    "brokers": {
      "type": "array",
      "description": "Lista de asesores/brokers con su tipo de inmueble y barrios asignados",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre del asesor"
          },
          "telefono": {
            "type": "string",
            "description": "Tel\u00e9fono con c\u00f3digo de pa\u00eds, sin + (ej: 573105771576)"
          },
          "genero": {
            "type": "string",
            "description": "G\u00e9nero del broker, para el vocabulario correcto (nuestra asesora / nuestro asesor)",
            "enum": [
              "F",
              "M"
            ]
          },
          "tipo_inmueble": {
            "type": "string",
            "description": "Tipo de inmueble que maneja este asesor",
            "enum": [
              "vivienda",
              "comercial",
              "ambos"
            ],
            "default": "ambos"
          },
          "barrios": {
            "type": "array",
            "description": "Barrios asignados (vac\u00edo = todos los del tipo)",
            "default": [],
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "clave"
  ]
}