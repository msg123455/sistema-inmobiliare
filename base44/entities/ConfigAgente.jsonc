{
  "type": "object",
  "name": "ConfigAgente",
  "properties": {
    "clave": {
      "type": "string",
      "description": "Clave única (usar 'general')"
    },
    "nombre_agente": {
      "type": "string",
      "description": "Identidad publica unica de los agentes",
      "default": "Asistente Inmobiliare"
    },
    "nombre_inmobiliaria": {
      "type": "string",
      "description": "Nombre de la inmobiliaria"
    },
    "instrucciones_sistema": {
      "type": "string",
      "description": "Campo legacy. El motor multiagente usa AgentePrompt."
    },
    "conocimiento_base": {
      "type": "array",
      "description": "Campo legacy. El motor multiagente usa ConocimientoRAG.",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "saludo_inicial": {
      "type": "string",
      "description": "Mensaje de saludo inicial. Usa {{nombre}}, {{agente}}, {{inmobiliaria}}"
    },
    "horario_inicio": {
      "type": "string",
      "description": "Hora inicio de atención (HH:MM)",
      "default": "08:00"
    },
    "horario_fin": {
      "type": "string",
      "description": "Hora fin de atención (HH:MM)",
      "default": "20:00"
    },
    "fuera_de_horario_mensaje": {
      "type": "string",
      "description": "Mensaje automático fuera del horario de atención"
    },
    "escalar_triggers": {
      "type": "array",
      "description": "Palabras clave que disparan escalación a un humano",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "activo": {
      "type": "boolean",
      "description": "Si el agente responde automáticamente",
      "default": true
    },
    "demora_respuesta_min": {
      "type": "number",
      "description": "Minutos que espera el agente antes de responder (0 = al instante, más humano si es 2). Requiere el cron enviarPendientes corriendo.",
      "default": 0
    },
    "aprendizajes": {
      "type": "string",
      "description": "Bloque de reglas aprendidas y APROBADAS que se inyectan a los agentes"
    },
    "numero_notificaciones": {
      "type": "string",
      "description": "Número (WhatsApp, con código de país, sin +) que recibe la notificación de lead calificado. Si está vacío, se usa el teléfono del broker asignado. NUNCA se envía al lead."
    },
    "telegram_notif_chat": {
      "type": "string",
      "description": "Chat ID de Telegram del equipo que recibe la notificación de lead calificado. Si está configurado, tiene prioridad sobre WhatsApp (Telegram no tiene ventana de 24h). NUNCA se envía al chat del lead."
    },
    "brokers": {
      "type": "array",
      "description": "Lista de asesores/brokers con su tipo de inmueble y barrios asignados",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre del asesor"
          },
          "telefono": {
            "type": "string",
            "description": "Teléfono con código de país, sin + (ej: 573105771576)"
          },
          "genero": {
            "type": "string",
            "description": "Género del broker, para el vocabulario correcto (nuestra asesora / nuestro asesor)",
            "enum": [
              "F",
              "M"
            ]
          },
          "tipo_inmueble": {
            "type": "string",
            "description": "Tipo de inmueble que maneja este asesor",
            "enum": [
              "vivienda",
              "comercial",
              "ambos"
            ],
            "default": "ambos"
          },
          "barrios": {
            "type": "array",
            "description": "Barrios asignados (vacío = todos los del tipo)",
            "default": [],
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "politica_datos_url": {
      "type": "string",
      "description": "URL de la politica de tratamiento de datos. Si esta vacia se usa la de _core/privacidad.ts."
    },
    "horario_equipo": {
      "type": "string",
      "description": "JSON con el horario del equipo comercial: {\"dias\":[1,2,3,4,5],\"desde\":9,\"hasta\":17}. Dias en ISO (1=lunes). Vacio usa lunes a viernes de 9 a 17."
    }
  },
  "required": [
    "clave"
  ]
}
