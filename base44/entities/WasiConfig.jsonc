{
  "type": "object",
  "name": "WasiConfig",
  "properties": {
    "clave": {
      "type": "string",
      "description": "Clave de configuraci\u00f3n (usar 'general')",
      "default": "general"
    },
    "api_key": {
      "type": "string",
      "description": "WASI API Key (wasi_token)"
    },
    "user_id": {
      "type": "string",
      "description": "WASI User ID (id_company)"
    },
    "activo": {
      "type": "boolean",
      "description": "Si la integraci\u00f3n est\u00e1 activa",
      "default": true
    },
    "estado_conexion": {
      "type": "string",
      "description": "Estado de la conexi\u00f3n con WASI",
      "enum": [
        "Conectado",
        "Desconectado",
        "Error",
        "No_configurado"
      ],
      "default": "No_configurado"
    },
    "ultimo_sync": {
      "type": "string",
      "description": "Fecha y hora del \u00faltimo sync",
      "format": "date-time"
    },
    "propiedades_sincronizadas": {
      "type": "number",
      "description": "Total de propiedades sincronizadas",
      "default": 0
    },
    "leads_importados": {
      "type": "number",
      "description": "Total de leads importados",
      "default": 0
    },
    "auto_sync_activo": {
      "type": "boolean",
      "description": "Activar sync autom\u00e1tico",
      "default": false
    },
    "auto_sync_horas": {
      "type": "number",
      "description": "Frecuencia del sync autom\u00e1tico en horas",
      "default": 6
    },
    "log_sync": {
      "type": "array",
      "description": "Historial de sincronizaciones",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "api_key",
    "user_id"
  ]
}