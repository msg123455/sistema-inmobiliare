{
  "name": "CampanaSocial",
  "type": "object",
  "description": "Publicaci\u00f3n de un inmueble en redes sociales, programada o inmediata. La publica la funci\u00f3n publishSocialPost v\u00eda Meta Graph API.",
  "properties": {
    "propiedad_id": {
      "type": "string",
      "description": "ID de la Propiedad que se promociona"
    },
    "propiedad_titulo": {
      "type": "string",
      "description": "T\u00edtulo de la propiedad, desnormalizado"
    },
    "plataforma": {
      "type": "string",
      "enum": [
        "Instagram",
        "Facebook",
        "Instagram_y_Facebook"
      ],
      "default": "Instagram",
      "description": "Red o redes donde se publica"
    },
    "caption": {
      "type": "string",
      "description": "Texto del post"
    },
    "fecha_programada": {
      "type": "string",
      "format": "date-time",
      "description": "Momento en que debe publicarse; vac\u00edo significa borrador"
    },
    "fecha_publicado": {
      "type": "string",
      "format": "date-time",
      "description": "Momento en que se public\u00f3 efectivamente"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Borrador",
        "Programado",
        "Publicado",
        "Error"
      ],
      "default": "Borrador",
      "description": "Estado de la publicaci\u00f3n"
    }
  },
  "required": [
    "propiedad_id"
  ]
}