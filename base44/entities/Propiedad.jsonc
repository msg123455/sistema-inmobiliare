{
  "type": "object",
  "name": "Propiedad",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo del inmueble"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n del inmueble"
    },
    "tipo": {
      "type": "string",
      "description": "Tipo de inmueble",
      "enum": [
        "Apartamento",
        "Casa",
        "Local",
        "Oficina",
        "Bodega",
        "Lote",
        "Finca",
        "Otro"
      ],
      "default": "Apartamento"
    },
    "operacion": {
      "type": "string",
      "description": "Tipo de operaci\u00f3n",
      "enum": [
        "Venta",
        "Arriendo",
        "Venta_y_Arriendo"
      ],
      "default": "Venta"
    },
    "estado": {
      "type": "string",
      "description": "Estado del inmueble",
      "enum": [
        "Disponible",
        "Reservado",
        "Vendido",
        "Arrendado",
        "No_disponible"
      ],
      "default": "Disponible"
    },
    "precio_venta": {
      "type": "number",
      "description": "Precio de venta en COP"
    },
    "canon_arriendo": {
      "type": "number",
      "description": "Canon de arriendo mensual en COP"
    },
    "administracion": {
      "type": "number",
      "description": "Cuota de administraci\u00f3n mensual en COP"
    },
    "comision_pct": {
      "type": "number",
      "description": "Porcentaje de comisi\u00f3n",
      "default": 3
    },
    "area_m2": {
      "type": "number",
      "description": "\u00c1rea en metros cuadrados"
    },
    "habitaciones": {
      "type": "number",
      "description": "N\u00famero de habitaciones"
    },
    "banos": {
      "type": "number",
      "description": "N\u00famero de ba\u00f1os"
    },
    "parqueaderos": {
      "type": "number",
      "description": "N\u00famero de parqueaderos"
    },
    "estrato": {
      "type": "number",
      "description": "Estrato socioecon\u00f3mico (1-6)"
    },
    "piso": {
      "type": "number",
      "description": "N\u00famero de piso"
    },
    "ciudad": {
      "type": "string",
      "description": "Ciudad del inmueble"
    },
    "barrio": {
      "type": "string",
      "description": "Barrio o zona"
    },
    "direccion": {
      "type": "string",
      "description": "Direcci\u00f3n completa"
    },
    "latitud": {
      "type": "number",
      "description": "Latitud GPS"
    },
    "longitud": {
      "type": "number",
      "description": "Longitud GPS"
    },
    "fotos": {
      "type": "array",
      "description": "URLs de fotos del inmueble",
      "items": {
        "type": "string"
      }
    },
    "valor_administracion": {
      "type": "number",
      "description": "Cuota de administraci\u00f3n mensual en COP (columna Administracion de la hoja Inventario)"
    },
    "proveedor": {
      "type": "string",
      "enum": [
        "simi",
        "csv",
        "manual"
      ],
      "default": "manual",
      "description": "De donde vino el registro. Clave unica: proveedor + codigo_externo."
    },
    "codigo_externo": {
      "type": "string",
      "description": "Codigo del inmueble en el sistema de origen (Cod en la hoja Inventario)"
    },
    "zona": {
      "type": "string",
      "description": "Zona de la ciudad"
    },
    "procedencia": {
      "type": "string",
      "description": "Como lleg\u00f3 el inmueble al portafolio"
    },
    "propietario_id": {
      "type": "string",
      "description": "Due\u00f1o del inmueble"
    },
    "contrato_activo_id": {
      "type": "string",
      "description": "Contrato de arriendo vigente, si est\u00e1 arrendado"
    },
    "duplicado_de": {
      "type": "string",
      "description": "Si la misma direcci\u00f3n lleg\u00f3 de dos proveedores, apunta al registro maestro. Nunca se borra: los leads referencian su id."
    },
    "portales": {
      "type": "object",
      "description": "Publicaci\u00f3n en portales externos (columnas METROCUADRADO, FINCARAIZ, MERCADOLIBRE de la hoja Inventario)",
      "properties": {
        "metrocuadrado": {
          "type": "string"
        },
        "fincaraiz": {
          "type": "string"
        },
        "mercadolibre": {
          "type": "string"
        }
      }
    },
    "publicado_instagram": {
      "type": "boolean",
      "description": "Publicado en Instagram",
      "default": false
    },
    "publicado_facebook": {
      "type": "boolean",
      "description": "Publicado en Facebook",
      "default": false
    },
    "link_web": {
      "type": "string",
      "description": "URL de la ficha de ESTE inmueble en la pagina web de Inmobiliare. Es el link que el agente manda al cliente: tiene prioridad sobre los portales externos, porque manda el trafico a nuestro sitio y no al de un tercero."
    },
    "link_instagram": {
      "type": "string",
      "description": "URL del post/reel de Instagram del inmueble (video). Valentina lo envia cuando piden ver el inmueble en video."
    },
    "asesor": {
      "type": "string",
      "description": "Asesor que capt\u00f3 el inmueble"
    },
    "fecha_consignado": {
      "type": "string",
      "description": "Fecha en que se consign\u00f3 el inmueble, formato AAAA-MM-DD"
    }
  },
  "required": [
    "titulo",
    "ciudad"
  ]
}