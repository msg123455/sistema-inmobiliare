{
  "type": "object",
  "name": "Propiedad",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo del inmueble"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n del inmueble"
    },
    "tipo": {
      "type": "string",
      "description": "Tipo de inmueble",
      "enum": [
        "Apartamento",
        "Casa",
        "Local",
        "Oficina",
        "Bodega",
        "Lote",
        "Finca",
        "Otro"
      ],
      "default": "Apartamento"
    },
    "operacion": {
      "type": "string",
      "description": "Tipo de operaci\u00f3n",
      "enum": [
        "Venta",
        "Arriendo",
        "Venta_y_Arriendo"
      ],
      "default": "Venta"
    },
    "estado": {
      "type": "string",
      "description": "Estado del inmueble",
      "enum": [
        "Disponible",
        "Reservado",
        "Vendido",
        "Arrendado",
        "No_disponible"
      ],
      "default": "Disponible"
    },
    "precio_venta": {
      "type": "number",
      "description": "Precio de venta en COP"
    },
    "canon_arriendo": {
      "type": "number",
      "description": "Canon de arriendo mensual en COP"
    },
    "administracion": {
      "type": "number",
      "description": "Cuota de administraci\u00f3n mensual en COP"
    },
    "comision_pct": {
      "type": "number",
      "description": "Porcentaje de comisi\u00f3n",
      "default": 3
    },
    "area_m2": {
      "type": "number",
      "description": "\u00c1rea en metros cuadrados"
    },
    "habitaciones": {
      "type": "number",
      "description": "N\u00famero de habitaciones"
    },
    "banos": {
      "type": "number",
      "description": "N\u00famero de ba\u00f1os"
    },
    "parqueaderos": {
      "type": "number",
      "description": "N\u00famero de parqueaderos"
    },
    "estrato": {
      "type": "number",
      "description": "Estrato socioecon\u00f3mico (1-6)"
    },
    "piso": {
      "type": "number",
      "description": "N\u00famero de piso"
    },
    "ciudad": {
      "type": "string",
      "description": "Ciudad del inmueble"
    },
    "barrio": {
      "type": "string",
      "description": "Barrio o zona"
    },
    "direccion": {
      "type": "string",
      "description": "Direcci\u00f3n completa"
    },
    "latitud": {
      "type": "number",
      "description": "Latitud GPS"
    },
    "longitud": {
      "type": "number",
      "description": "Longitud GPS"
    },
    "fotos": {
      "type": "array",
      "description": "URLs de fotos del inmueble",
      "items": {
        "type": "string"
      }
    },
    "publicado_wasi": {
      "type": "boolean",
      "description": "Publicado en WASI.co",
      "default": false
    },
    "publicado_instagram": {
      "type": "boolean",
      "description": "Publicado en Instagram",
      "default": false
    },
    "publicado_facebook": {
      "type": "boolean",
      "description": "Publicado en Facebook",
      "default": false
    },
    "fuente_wasi": {
      "type": "boolean",
      "description": "Importado desde WASI",
      "default": false
    },
    "wasi_id": {
      "type": "string",
      "description": "ID de la propiedad en WASI.co"
    },
    "link_wasi": {
      "type": "string",
      "description": "URL de la propiedad en WASI.co"
    },
    "link_instagram": {
      "type": "string",
      "description": "URL del post/reel de Instagram del inmueble (video). Valentina lo envia cuando piden ver el inmueble en video."
    }
  },
  "required": [
    "titulo",
    "ciudad"
  ]
}