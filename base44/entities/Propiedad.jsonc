{
  "type": "object",
  "name": "Propiedad",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "Título del inmueble"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción del inmueble"
    },
    "tipo": {
      "type": "string",
      "description": "Tipo de inmueble",
      "enum": [
        "Apartamento",
        "Casa",
        "Local",
        "Oficina",
        "Bodega",
        "Lote",
        "Finca",
        "Otro"
      ],
      "default": "Apartamento"
    },
    "operacion": {
      "type": "string",
      "description": "Tipo de operación",
      "enum": [
        "Venta",
        "Arriendo",
        "Venta_y_Arriendo"
      ],
      "default": "Venta"
    },
    "estado": {
      "type": "string",
      "description": "Estado del inmueble",
      "enum": [
        "Disponible",
        "Reservado",
        "Vendido",
        "Arrendado",
        "No_disponible"
      ],
      "default": "Disponible"
    },
    "precio_venta": {
      "type": "number",
      "description": "Precio de venta en COP"
    },
    "canon_arriendo": {
      "type": "number",
      "description": "Canon de arriendo mensual en COP"
    },
    "administracion": {
      "type": "number",
      "description": "Cuota de administración mensual en COP"
    },
    "comision_pct": {
      "type": "number",
      "description": "Porcentaje de comisión",
      "default": 3
    },
    "area_m2": {
      "type": "number",
      "description": "Área en metros cuadrados"
    },
    "habitaciones": {
      "type": "number",
      "description": "Número de habitaciones"
    },
    "banos": {
      "type": "number",
      "description": "Número de baños"
    },
    "parqueaderos": {
      "type": "number",
      "description": "Número de parqueaderos"
    },
    "estrato": {
      "type": "number",
      "description": "Estrato socioeconómico (1-6)"
    },
    "piso": {
      "type": "number",
      "description": "Número de piso"
    },
    "ciudad": {
      "type": "string",
      "description": "Ciudad del inmueble"
    },
    "barrio": {
      "type": "string",
      "description": "Barrio o zona"
    },
    "direccion": {
      "type": "string",
      "description": "Dirección completa"
    },
    "latitud": {
      "type": "number",
      "description": "Latitud GPS"
    },
    "longitud": {
      "type": "number",
      "description": "Longitud GPS"
    },
    "fotos": {
      "type": "array",
      "description": "URLs de fotos del inmueble",
      "items": {
        "type": "string"
      }
    },
    "valor_administracion": {
      "type": "number",
      "description": "Cuota de administración mensual en COP (columna Administracion de la hoja Inventario)"
    },
    "proveedor": {
      "type": "string",
      "enum": [
        "simi",
        "csv",
        "manual"
      ],
      "default": "manual",
      "description": "De donde vino el registro. Clave unica: proveedor + codigo_externo."
    },
    "codigo_externo": {
      "type": "string",
      "description": "Codigo del inmueble en el sistema de origen (Cod en la hoja Inventario)"
    },
    "zona": {
      "type": "string",
      "description": "Zona de la ciudad"
    },
    "procedencia": {
      "type": "string",
      "description": "Como llegó el inmueble al portafolio"
    },
    "propietario_id": {
      "type": "string",
      "description": "Dueño del inmueble"
    },
    "contrato_activo_id": {
      "type": "string",
      "description": "Contrato de arriendo vigente, si está arrendado"
    },
    "duplicado_de": {
      "type": "string",
      "description": "Si la misma dirección llegó de dos proveedores, apunta al registro maestro. Nunca se borra: los leads referencian su id."
    },
    "portales": {
      "type": "object",
      "description": "Links publicos del inmueble en portales externos. Los pone el detalle de SIMI. Solo se guardan los que traen URL de verdad: la API manda tambien Doomos, Olx, Properati, Idonde, Lamudi, Proppit, GoPlaceIt y La Haus, pero siempre con la url vacia.",
      "properties": {
        "metrocuadrado": {
          "type": "string"
        },
        "fincaraiz": {
          "type": "string"
        },
        "mercadolibre": {
          "type": "string"
        },
        "ciencuadras": {
          "type": "string",
          "description": "URL de la ficha en CienCuadras. Es el portal de mejor cobertura medida (43 de 45): cuando el agente manda un link, casi siempre es este."
        },
        "zonahabitat": {
          "type": "string",
          "description": "URL de la ficha en Zona Habitat."
        }
      }
    },
    "publicado_instagram": {
      "type": "boolean",
      "description": "Publicado en Instagram",
      "default": false
    },
    "publicado_facebook": {
      "type": "boolean",
      "description": "Publicado en Facebook",
      "default": false
    },
    "link_web": {
      "type": "string",
      "description": "URL de la ficha de ESTE inmueble en la pagina web de Inmobiliare. Es el link que el agente manda al cliente: tiene prioridad sobre los portales externos, porque manda el trafico a nuestro sitio y no al de un tercero."
    },
    "link_instagram": {
      "type": "string",
      "description": "URL del post/reel de Instagram del inmueble (video). Valentina lo envia cuando piden ver el inmueble en video."
    },
    "asesor": {
      "type": "string",
      "description": "Asesor que captó el inmueble"
    },
    "fecha_consignado": {
      "type": "string",
      "description": "Fecha en que se consignó el inmueble, formato AAAA-MM-DD"
    },
    "caracteristicas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Caracteristicas del inmueble segun SIMI (ascensor, piscina, gimnasio, chimenea, deposito...). Es lo que le permite al agente responder \"tiene ascensor?\" sin escalar."
    },
    "asesor_celular": {
      "type": "string",
      "description": "Celular del asesor que tiene el inmueble, segun SIMI. Para escalar al humano correcto, no para darselo al cliente."
    },
    "asesor_correo": {
      "type": "string",
      "description": "Correo del asesor que tiene el inmueble, segun SIMI."
    },
    "localidad": {
      "type": "string",
      "description": "Localidad de Bogota (Chapinero, Usaquen, Suba...). Mas fina que la zona y mas gruesa que el barrio."
    },
    "admon_incluida": {
      "type": "boolean",
      "default": false,
      "description": "Si la administracion ya va incluida en el canon. Cambia lo que el cliente paga de verdad al mes: sin esto el agente cotiza de menos o de mas."
    },
    "amoblado": {
      "type": "boolean",
      "default": false,
      "description": "Si el inmueble se entrega amoblado. Filtro habitual en arriendo."
    },
    "avaluo_catastral": {
      "type": "number",
      "description": "Avaluo catastral en COP segun SIMI. Referencia para el agente de avaluos; no sustituye un avaluo firmado por avaluador inscrito en el RAA."
    }
  },
  "required": [
    "titulo",
    "ciudad"
  ]
}
