{
  "name": "CodigoBarras",
  "type": "object",
  "properties": {
    "arrendatario_id": {
      "type": "string",
      "description": "A quien se le envia"
    },
    "contrato_id": {
      "type": "string",
      "description": "Contrato al que corresponde"
    },
    "periodo": {
      "type": "string",
      "description": "Mes en formato AAAA-MM"
    },
    "url_pdf": {
      "type": "string",
      "description": "PDF del recibo"
    },
    "codigo": {
      "type": "string",
      "description": "Codigo de barras"
    },
    "valor": {
      "type": "number",
      "description": "Valor a pagar"
    },
    "fecha_envio": {
      "type": "string",
      "format": "date-time",
      "description": "Cuando se envio"
    },
    "canal_envio": {
      "type": "string",
      "description": "Por donde se envio"
    },
    "estado_envio": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Enviado",
        "Fallido"
      ],
      "default": "Pendiente",
      "description": "Como quedo el envio"
    },
    "sha256": {
      "type": "string",
      "description": "Huella del PDF subido. Permite comprobar que la URL sirve exactamente ese archivo"
    },
    "email_destino": {
      "type": "string",
      "description": "Correo al que se le envio. La auditoria vive aqui aunque el listado venga de un Excel"
    },
    "nombre_destino": {
      "type": "string",
      "description": "Nombre del inquilino, para no mostrar 600 filas sin nombre en Envios"
    },
    "mailchimp_file_id": {
      "type": "string",
      "description": "Id del archivo en Mailchimp. Sirve para reanudar sin duplicar y para limpiar huerfanos"
    }
  },
  "required": [
    "periodo"
  ]
}