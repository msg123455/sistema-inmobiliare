{
  "name": "CodigoBarras",
  "type": "object",
  "properties": {
    "arrendatario_id": {
      "type": "string",
      "description": "A quien se le envia"
    },
    "contrato_id": {
      "type": "string",
      "description": "Contrato al que corresponde"
    },
    "periodo": {
      "type": "string",
      "description": "Mes en formato AAAA-MM"
    },
    "url_pdf": {
      "type": "string",
      "description": "PDF del recibo"
    },
    "codigo": {
      "type": "string",
      "description": "Codigo de barras"
    },
    "valor": {
      "type": "number",
      "description": "Valor a pagar"
    },
    "fecha_envio": {
      "type": "string",
      "format": "date-time",
      "description": "Cuando se envio"
    },
    "canal_envio": {
      "type": "string",
      "description": "Por donde se envio"
    },
    "estado_envio": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Enviado",
        "Fallido"
      ],
      "default": "Pendiente",
      "description": "Como quedo el envio"
    }

    // PENDIENTES DE CREAR EN EL PANEL, y a proposito NO declarados aqui arriba:
    //
    //   sha256             huella del PDF; permite probar que la URL sirve ese archivo
    //   email_destino      a quien se le envio
    //   nombre_destino     para no ver 600 filas "Sin nombre" en Envios
    //   mailchimp_file_id  reanudar sin duplicar y limpiar huerfanos
    //
    // Estuvieron declarados arriba un rato y hubo que sacarlos: el constructor
    // de Base44 LEE ESTE ARCHIVO, vio los campos y contesto "ya existen, no se
    // necesita ningun cambio" —mientras la base seguia con nueve—. Documentarlos
    // como si existieran impide crearlos.
    //
    // Que este archivo no sea el esquema vivo es justo el motivo de la sonda:
    // Base44 descarta en silencio los campos que no existen, asi que la unica
    // prueba concluyente es escribir una fila, releerla y ver que sobrevivio.
  },
  "required": [
    "periodo"
  ]
}
