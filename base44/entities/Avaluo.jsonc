{
  "name": "Avaluo",
  "type": "object",
  "properties": {
    "solicitante_nombre": {
      "type": "string",
      "description": "Quien lo pide"
    },
    "solicitante_telefono": {
      "type": "string",
      "description": "Telefono de contacto"
    },
    "solicitante_email": {
      "type": "string",
      "description": "Correo de contacto"
    },
    "propietario_id": {
      "type": "string",
      "description": "Propietario, si ya es cliente"
    },
    "direccion": {
      "type": "string",
      "description": "Direccion del inmueble a avaluar"
    },
    "tipo_inmueble": {
      "type": "string",
      "enum": [
        "Apartamento",
        "Casa",
        "Local",
        "Oficina",
        "Bodega",
        "Lote",
        "Finca",
        "Otro"
      ],
      "description": "Tipo"
    },
    "area_m2": {
      "type": "number",
      "description": "Area en metros cuadrados"
    },
    "proposito": {
      "type": "string",
      "enum": [
        "Venta",
        "Arriendo",
        "Credito",
        "Sucesion",
        "Otro"
      ],
      "description": "Para que lo necesita"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Solicitado",
        "Cotizado",
        "Aceptado",
        "Agendado",
        "En_proceso",
        "Entregado",
        "Cancelado"
      ],
      "default": "Solicitado",
      "description": "Como va"
    },
    "valor_servicio": {
      "type": "number",
      "description": "Lo que cuesta el avaluo"
    },
    "perito_id": {
      "type": "string",
      "description": "Perito asignado"
    },
    "fecha_visita": {
      "type": "string",
      "format": "date-time",
      "description": "Cuando se visita el inmueble"
    },
    "valor_resultante": {
      "type": "number",
      "description": "Valor comercial que arrojo el avaluo"
    },
    "documento_id": {
      "type": "string",
      "description": "Informe final"
    },
    "origen": {
      "type": "string",
      "description": "Por donde entro"
    },
    "fecha_solicitud": {
      "type": "string",
      "format": "date-time",
      "description": "Cuando se pidio"
    }
  },
  "required": [
    "direccion"
  ]
}
