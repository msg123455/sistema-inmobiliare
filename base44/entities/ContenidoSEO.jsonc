{
  "type": "object",
  "name": "ContenidoSEO",
  "properties": {
    "nodo_id": {
      "type": "string",
      "description": "ID del NodoSitemap del que proviene"
    },
    "keyword_principal": {
      "type": "string",
      "description": "Keyword objetivo del art\u00edculo"
    },
    "title": {
      "type": "string",
      "description": "Title tag (m\u00e1x 60 caracteres)"
    },
    "slug": {
      "type": "string",
      "description": "Slug de la URL"
    },
    "meta_description": {
      "type": "string",
      "description": "Meta description (m\u00e1x 160 caracteres)"
    },
    "content_sections": {
      "type": "string",
      "description": "Secciones del art\u00edculo serializadas en JSON"
    },
    "faq_items": {
      "type": "string",
      "description": "Preguntas frecuentes serializadas en JSON"
    },
    "schema_jsonld": {
      "type": "string",
      "description": "Schema.org JSON-LD de la p\u00e1gina"
    },
    "cta_text": {
      "type": "string",
      "description": "Llamado a la acci\u00f3n de cierre"
    },
    "aeo_data": {
      "type": "string",
      "description": "Optimizaci\u00f3n para motores de respuesta (AI Overviews, ChatGPT) en JSON"
    },
    "palabras": {
      "type": "number",
      "description": "Conteo aproximado de palabras"
    },
    "estado": {
      "type": "string",
      "description": "Estado editorial del contenido",
      "enum": [
        "pendiente",
        "aprobado",
        "rechazado"
      ],
      "default": "pendiente"
    },
    "export_html": {
      "type": "string",
      "description": "HTML final listo para exportar al CMS"
    }
  },
  "required": [
    "keyword_principal"
  ]
}