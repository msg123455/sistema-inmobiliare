{
  "type": "object",
  "name": "Meta",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo de la meta"
    },
    "tipo": {
      "type": "string",
      "description": "Tipo de meta",
      "enum": [
        "leads",
        "cierres",
        "revenue_usd"
      ]
    },
    "valor_meta": {
      "type": "number",
      "description": "Valor objetivo"
    },
    "valor_actual": {
      "type": "number",
      "description": "Progreso actual",
      "default": 0
    },
    "mes": {
      "type": "number",
      "description": "Mes objetivo (1-12)"
    },
    "anio": {
      "type": "number",
      "description": "A\u00f1o objetivo"
    },
    "asignado_a": {
      "type": "string",
      "description": "Email del responsable"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n o contexto de la meta"
    },
    "completada": {
      "type": "boolean",
      "description": "Si la meta fue alcanzada",
      "default": false
    }
  },
  "required": [
    "titulo",
    "tipo",
    "valor_meta",
    "mes",
    "anio"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}
