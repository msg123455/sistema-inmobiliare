{
  "type": "object",
  "name": "Contacto",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre completo del contacto"
    },
    "email": {
      "type": "string",
      "description": "Correo electr\u00f3nico"
    },
    "telefono": {
      "type": "string",
      "description": "N\u00famero de tel\u00e9fono / WhatsApp"
    },
    "tipo_interes": {
      "type": "string",
      "description": "Tipo de operaci\u00f3n que busca",
      "enum": [
        "Compra",
        "Arriendo",
        "Compra_y_Arriendo",
        "Otro"
      ]
    },
    "etapa_pipeline": {
      "type": "string",
      "description": "Etapa en el pipeline de ventas",
      "enum": [
        "Lead",
        "Visita_Agendada",
        "Oferta",
        "Negociacion",
        "Promesa",
        "Escritura",
        "Activo",
        "Perdido"
      ],
      "default": "Lead"
    },
    "pipeline_tipo": {
      "type": "string",
      "description": "Tipo de pipeline",
      "enum": [
        "Venta",
        "Arriendo",
        "Ambos"
      ]
    },
    "temperatura": {
      "type": "string",
      "description": "Temperatura del lead",
      "enum": [
        "Frio",
        "Tibio",
        "Caliente",
        "Urgente"
      ]
    },
    "score_lead": {
      "type": "number",
      "description": "Score del lead (0-100)"
    },
    "presupuesto_max": {
      "type": "number",
      "description": "Presupuesto m\u00e1ximo en COP"
    },
    "ciudad_interes": {
      "type": "string",
      "description": "Ciudad de inter\u00e9s"
    },
    "habitaciones_min": {
      "type": "number",
      "description": "M\u00ednimo de habitaciones requeridas"
    },
    "asignado_a": {
      "type": "string",
      "description": "Broker o asesor asignado"
    },
    "canal_adquisicion": {
      "type": "string",
      "description": "Canal por el que lleg\u00f3 el contacto"
    },
    "fecha_primer_contacto": {
      "type": "string",
      "description": "Fecha del primer contacto",
      "format": "date"
    },
    "ultima_actividad": {
      "type": "string",
      "description": "\u00daltima actividad registrada",
      "format": "date-time"
    },
    "en_conversacion": {
      "type": "boolean",
      "description": "Est\u00e1 actualmente en conversaci\u00f3n con Valentina",
      "default": false
    },
    "ia_calificado": {
      "type": "boolean",
      "description": "Fue calificado por Valentina (IA)",
      "default": false
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales / resumen de Valentina"
    },
    "estado_seguimiento": {
      "type": "string",
      "description": "Ciclo de vida post-entrega: Asignado, Contactado, Cita_Agendada, Visita_Realizada, No_Contesta, Paro_De_Contestar, Cerrado_Ganado, Cerrado_Perdido"
    },
    "broker_telefono": {
      "type": "string",
      "description": "Tel\u00e9fono del broker asignado"
    },
    "fecha_asignacion": {
      "type": "string",
      "description": "Cu\u00e1ndo se entreg\u00f3 el lead al broker",
      "format": "date-time"
    },
    "fecha_ultimo_avance": {
      "type": "string",
      "description": "\u00daltimo cambio de estado de seguimiento (para detectar enfriamiento)",
      "format": "date-time"
    },
    "recordatorios_broker": {
      "type": "number",
      "description": "Cu\u00e1ntos recordatorios se han enviado al broker por este lead",
      "default": 0
    },
    "descalificado": {
      "type": "boolean",
      "description": "El lead fue descalificado (no encaja: ciudad/presupuesto fuera de rango)",
      "default": false
    },
    "motivo_descalificacion": {
      "type": "string",
      "description": "Motivo por el que el lead fue descalificado"
    },
    "motivo_perdida": {
      "type": "string",
      "description": "Motivo por el que se perdi\u00f3 el negocio (distinto de descalificaci\u00f3n)"
    },
    "arrendatario_id": {
      "type": "string",
      "description": "Si este contacto ya es arrendatario nuestro"
    },
    "propietario_id": {
      "type": "string",
      "description": "Si este contacto ya es propietario nuestro"
    },
    "es_cliente_actual": {
      "type": "boolean",
      "default": false,
      "description": "Señal de ruteo nivel A: un cliente actual que escribe sin decir a que viene va a cartera, no a ventas"
    },
    "fuente_wasi": {
      "type": "boolean",
      "description": "Lead proveniente de WASI",
      "default": false
    },
    "wasi_lead_id": {
      "type": "string",
      "description": "ID del lead en WASI.co"
    }
  },
  "required": [
    "nombre"
  ]
}