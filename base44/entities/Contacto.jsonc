{
  "type": "object",
  "name": "Contacto",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre completo del contacto"
    },
    "email": {
      "type": "string",
      "description": "Correo electrónico"
    },
    "telefono": {
      "type": "string",
      "description": "Número de teléfono / WhatsApp"
    },
    "tipo_interes": {
      "type": "string",
      "description": "Tipo de operación que busca",
      "enum": [
        "Compra",
        "Arriendo",
        "Compra_y_Arriendo",
        "Otro"
      ]
    },
    "etapa_pipeline": {
      "type": "string",
      "description": "Etapa en el pipeline de ventas",
      "enum": [
        "Lead",
        "Visita_Agendada",
        "Oferta",
        "Negociacion",
        "Promesa",
        "Escritura",
        "Activo",
        "Perdido"
      ],
      "default": "Lead"
    },
    "pipeline_tipo": {
      "type": "string",
      "description": "Tipo de pipeline",
      "enum": [
        "Venta",
        "Arriendo",
        "Ambos"
      ]
    },
    "temperatura": {
      "type": "string",
      "description": "Temperatura del lead",
      "enum": [
        "Frio",
        "Tibio",
        "Caliente",
        "Urgente"
      ]
    },
    "score_lead": {
      "type": "number",
      "description": "Score del lead (0-100)"
    },
    "presupuesto_max": {
      "type": "number",
      "description": "Presupuesto máximo en COP"
    },
    "ciudad_interes": {
      "type": "string",
      "description": "Ciudad de interés"
    },
    "habitaciones_min": {
      "type": "number",
      "description": "Mínimo de habitaciones requeridas"
    },
    "asignado_a": {
      "type": "string",
      "description": "Broker o asesor asignado"
    },
    "canal_adquisicion": {
      "type": "string",
      "description": "Canal por el que llegó el contacto"
    },
    "fecha_primer_contacto": {
      "type": "string",
      "description": "Fecha del primer contacto",
      "format": "date"
    },
    "ultima_actividad": {
      "type": "string",
      "description": "Última actividad registrada",
      "format": "date-time"
    },
    "en_conversacion": {
      "type": "boolean",
      "description": "Está actualmente en conversación con Valentina",
      "default": false
    },
    "ia_calificado": {
      "type": "boolean",
      "description": "Fue calificado por Valentina (IA)",
      "default": false
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales / resumen de Valentina"
    },
    "estado_seguimiento": {
      "type": "string",
      "description": "Ciclo de vida post-entrega: Asignado, Contactado, Cita_Agendada, Visita_Realizada, No_Contesta, Paro_De_Contestar, Cerrado_Ganado, Cerrado_Perdido"
    },
    "broker_telefono": {
      "type": "string",
      "description": "Teléfono del broker asignado"
    },
    "fecha_asignacion": {
      "type": "string",
      "description": "Cuándo se entregó el lead al broker",
      "format": "date-time"
    },
    "fecha_ultimo_avance": {
      "type": "string",
      "description": "Último cambio de estado de seguimiento (para detectar enfriamiento)",
      "format": "date-time"
    },
    "recordatorios_broker": {
      "type": "number",
      "description": "Cuántos recordatorios se han enviado al broker por este lead",
      "default": 0
    },
    "descalificado": {
      "type": "boolean",
      "description": "El lead fue descalificado (no encaja: ciudad/presupuesto fuera de rango)",
      "default": false
    },
    "motivo_descalificacion": {
      "type": "string",
      "description": "Motivo por el que el lead fue descalificado"
    },
    "motivo_perdida": {
      "type": "string",
      "description": "Motivo por el que se perdió el negocio (distinto de descalificación)"
    },
    "arrendatario_id": {
      "type": "string",
      "description": "Si este contacto ya es arrendatario nuestro"
    },
    "propietario_id": {
      "type": "string",
      "description": "Si este contacto ya es propietario nuestro"
    },
    "es_cliente_actual": {
      "type": "boolean",
      "default": false,
      "description": "Señal de ruteo nivel A: un cliente actual que escribe sin decir a que viene va a cartera, no a ventas"
    },
    "fuente_wasi": {
      "type": "boolean",
      "description": "Lead proveniente de WASI",
      "default": false
    },
    "wasi_lead_id": {
      "type": "string",
      "description": "ID del lead en WASI.co"
    },
    "autoriza_tratamiento": {
      "type": "boolean",
      "default": false,
      "description": "Si se le entrego el aviso de tratamiento de datos (Ley 1581/2012). Lo escribe el codigo al enviar el aviso, no el modelo."
    },
    "fecha_autorizacion": {
      "type": "string",
      "format": "date-time",
      "description": "Cuando se entrego el aviso. Es la evidencia de la autorizacion."
    },
    "politica_version": {
      "type": "string",
      "description": "Version de la politica vigente al momento del aviso. Si cambia, se vuelve a avisar."
    }
  },
  "required": [
    "nombre"
  ]
}
