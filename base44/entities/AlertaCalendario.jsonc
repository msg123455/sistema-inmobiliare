{
  "type": "object",
  "name": "AlertaCalendario",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID \u00fanico del evento en Google Calendar"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo del evento"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n del evento"
    },
    "fecha_inicio": {
      "type": "string",
      "description": "Fecha y hora de inicio del evento",
      "format": "date-time"
    },
    "fecha_fin": {
      "type": "string",
      "description": "Fecha y hora de fin del evento",
      "format": "date-time"
    },
    "ubicacion": {
      "type": "string",
      "description": "Ubicaci\u00f3n del evento"
    },
    "enlace_meet": {
      "type": "string",
      "description": "Link de Google Meet si existe"
    },
    "leido": {
      "type": "boolean",
      "description": "Si la alerta ha sido le\u00edda",
      "default": false
    }
  },
  "required": [
    "event_id",
    "titulo",
    "fecha_inicio"
  ]
}