{
  "type": "object",
  "name": "GastoFijo",
  "properties": {
    "concepto": {
      "type": "string",
      "description": "Concepto del gasto"
    },
    "categoria": {
      "type": "string",
      "description": "Categor\u00eda del gasto",
      "enum": [
        "nomina",
        "arriendo",
        "servicios",
        "software",
        "transporte",
        "legal",
        "marketing",
        "otro"
      ],
      "default": "otro"
    },
    "monto_mensual": {
      "type": "number",
      "description": "Monto mensual en USD"
    },
    "activo": {
      "type": "boolean",
      "description": "Si el gasto est\u00e1 activo",
      "default": true
    }
  },
  "required": [
    "concepto",
    "monto_mensual"
  ]
}