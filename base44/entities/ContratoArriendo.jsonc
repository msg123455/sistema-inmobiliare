{
  "name": "ContratoArriendo",
  "type": "object",
  "description": "Contrato de arrendamiento entre propietario y arrendatario, administrado por la inmobiliaria. Soporta renovaci\u00f3n autom\u00e1tica con incremento anual.",
  "properties": {
    "propiedad_id": {
      "type": "string",
      "description": "ID de la Propiedad arrendada"
    },
    "propiedad_titulo": {
      "type": "string",
      "description": "T\u00edtulo de la propiedad, desnormalizado para listar sin join"
    },
    "contacto_id": {
      "type": "string",
      "description": "ID del Contacto que act\u00faa como arrendatario"
    },
    "arrendatario_nombre": {
      "type": "string",
      "description": "Nombre del arrendatario, desnormalizado"
    },
    "propietario_id": {
      "type": "string",
      "description": "ID del Propietario del inmueble"
    },
    "propietario_nombre": {
      "type": "string",
      "description": "Nombre del propietario, desnormalizado"
    },
    "canon_mensual": {
      "type": "number",
      "description": "Canon de arrendamiento mensual en COP"
    },
    "administracion_pct": {
      "type": "number",
      "default": 10,
      "description": "Porcentaje de administraci\u00f3n que retiene la inmobiliaria"
    },
    "deposito": {
      "type": "number",
      "description": "Dep\u00f3sito o garant\u00eda en COP"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio del contrato"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date",
      "description": "Fecha de vencimiento del contrato"
    },
    "duracion_meses": {
      "type": "number",
      "default": 12,
      "description": "Duraci\u00f3n del contrato en meses"
    },
    "incremento_anual_pct": {
      "type": "number",
      "default": 4,
      "description": "Porcentaje de incremento aplicado en cada renovaci\u00f3n"
    },
    "dia_pago": {
      "type": "number",
      "default": 1,
      "description": "D\u00eda del mes en que vence el pago del canon (1-28)"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Activo",
        "Por_vencer",
        "Vencido",
        "Terminado"
      ],
      "default": "Activo",
      "description": "Estado del contrato"
    },
    "renovaciones": {
      "type": "array",
      "description": "Hist\u00f3rico de renovaciones aplicadas",
      "items": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date",
            "description": "Fecha en que se aplic\u00f3 la renovaci\u00f3n"
          },
          "nuevo_canon": {
            "type": "number",
            "description": "Canon resultante tras el incremento"
          },
          "nueva_fecha_fin": {
            "type": "string",
            "format": "date",
            "description": "Nueva fecha de vencimiento"
          }
        }
      }
    },
    "notas": {
      "type": "string",
      "description": "Notas internas del contrato"
    }
  },
  "required": [
    "propiedad_id",
    "contacto_id",
    "canon_mensual",
    "fecha_inicio"
  ]
}