{
  "name": "Documento",
  "type": "object",
  "properties": {
    "contacto_id": {
      "type": "string",
      "description": "Referencia a Contacto. Es el campo correcto para escrituras nuevas."
    },
    "cliente_id": {
      "type": "string",
      "description": "LEGACY. Referencia a la entidad Cliente (codigo muerto). No usar en escrituras nuevas."
    },
    "reparacion_id": {
      "type": "string",
      "description": "Reparacion a la que pertenece la evidencia, si aplica"
    },
    "avaluo_id": {
      "type": "string",
      "description": "Avaluo al que pertenece el informe, si aplica"
    },
    "contrato_id": {
      "type": "string",
      "description": "Contrato al que pertenece el documento, si aplica"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre del archivo"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "evidencia",
        "recibo",
        "carta",
        "contrato",
        "identificacion",
        "informe",
        "otro"
      ],
      "default": "otro",
      "description": "Categoría del documento"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción opcional del documento"
    },
    "tipo_mime": {
      "type": "string",
      "description": "Tipo MIME del archivo (ej: image/jpeg, application/pdf)"
    },
    "tamanio_bytes": {
      "type": "number",
      "description": "Tamaño del archivo en bytes"
    },
    "estado": {
      "type": "string",
      "enum": ["borrador", "revision", "final"],
      "default": "final",
      "description": "Los borradores del copiloto de contratos nacen aqui. Nunca se autoenvian ni autofirman."
    },
    "contenido": {
      "type": "string",
      "description": "URL del archivo subido (vía UploadFile)"
    }
  },
  "required": [
    "nombre",
    "categoria"
  ]
}
