{
  "type": "object",
  "name": "ConfigFinanciera",
  "properties": {
    "clave": {
      "type": "string",
      "description": "Clave \u00fanica (ej: 'general')"
    },
    "gastos_fijos_mes": {
      "type": "number",
      "description": "Gastos fijos mensuales de la empresa (USD)",
      "default": 0
    },
    "salarios_mes": {
      "type": "number",
      "description": "N\u00f3mina mensual (USD)",
      "default": 0
    },
    "otros_gastos_mes": {
      "type": "number",
      "description": "Otros gastos operativos mensuales (USD)",
      "default": 0
    },
    "tasa_impuesto_renta": {
      "type": "number",
      "description": "Tasa de impuesto de renta en %",
      "default": 35
    },
    "tasa_iva": {
      "type": "number",
      "description": "IVA en %",
      "default": 19
    },
    "reserva_legal_pct": {
      "type": "number",
      "description": "% de reserva legal sobre utilidades",
      "default": 10
    },
    "capital_inicial": {
      "type": "number",
      "description": "Capital inicial disponible (USD)",
      "default": 0
    }
  },
  "required": [
    "clave"
  ]
}