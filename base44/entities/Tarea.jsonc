{
  "name": "Tarea",
  "type": "object",
  "properties": {
    "contacto_id": {
      "type": "string",
      "description": "Referencia a Contacto. Es el campo correcto: las entidades nuevas nunca usan cliente_id."
    },
    "cliente_id": {
      "type": "string",
      "description": "LEGACY. Referencia a la entidad Cliente (codigo muerto). No usar en escrituras nuevas; se retira cuando termine el backfill a contacto_id."
    },
    "titulo": {
      "type": "string",
      "description": "Título de la tarea"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción detallada"
    },
    "fecha_limite": {
      "type": "string",
      "format": "date",
      "description": "Fecha límite para completar"
    },
    "completada": {
      "type": "boolean",
      "default": false,
      "description": "Si la tarea está completada"
    },
    "asignado_a": {
      "type": "string",
      "description": "Email del usuario asignado"
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "Baja",
        "Media",
        "Alta"
      ],
      "default": "Media",
      "description": "Prioridad de la tarea"
    },
    "origen_agente": {
      "type": "string",
      "description": "Agente de IA que creo la tarea, si vino de una conversacion"
    }
  },
  "required": [
    "titulo",
    "fecha_limite"
  ]
}
