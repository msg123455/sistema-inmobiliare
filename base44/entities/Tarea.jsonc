{
  "type": "object",
  "name": "Tarea",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente (referencia a Cliente)"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo de la tarea"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n detallada"
    },
    "fecha_limite": {
      "type": "string",
      "description": "Fecha l\u00edmite para completar",
      "format": "date"
    },
    "completada": {
      "type": "boolean",
      "description": "Si la tarea est\u00e1 completada",
      "default": false
    },
    "asignado_a": {
      "type": "string",
      "description": "Email del usuario asignado"
    },
    "prioridad": {
      "type": "string",
      "description": "Prioridad de la tarea",
      "enum": [
        "Baja",
        "Media",
        "Alta"
      ],
      "default": "Media"
    }
  },
  "required": [
    "cliente_id",
    "titulo",
    "fecha_limite"
  ]
}