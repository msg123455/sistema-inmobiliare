{
  "name": "Tarea",
  "type": "object",
  "properties": {
    "contacto_id": {
      "type": "string",
      "description": "ID del Contacto vinculado. Campo destino: reemplaza a cliente_id."
    },
    "cliente_id": {
      "type": "string",
      "description": "OBSOLETO. Apuntaba a la entidad Cliente del modelo anterior. Se sigue escribiendo con el mismo valor que contacto_id porque todavia es required; se elimina tras el backfill."
    },
    "hora": {
      "type": "string",
      "description": "Hora de la tarea en formato HH:MM. El codigo ya la escribia sin estar declarada."
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo de la tarea"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n detallada"
    },
    "fecha_limite": {
      "type": "string",
      "format": "date",
      "description": "Fecha l\u00edmite para completar"
    },
    "completada": {
      "type": "boolean",
      "default": false,
      "description": "Si la tarea est\u00e1 completada"
    },
    "asignado_a": {
      "type": "string",
      "description": "Email del usuario asignado"
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "Baja",
        "Media",
        "Alta"
      ],
      "default": "Media",
      "description": "Prioridad de la tarea"
    }
  },
  "required": [
    "cliente_id",
    "titulo",
    "fecha_limite"
  ]
}