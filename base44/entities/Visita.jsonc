{
  "name": "Visita",
  "type": "object",
  "description": "Visita de un contacto a un inmueble, presencial o virtual. Agendada por un asesor o por el agente conversacional.",
  "properties": {
    "propiedad_id": {
      "type": "string",
      "description": "ID de la Propiedad visitada"
    },
    "propiedad_titulo": {
      "type": "string",
      "description": "T\u00edtulo de la propiedad, desnormalizado"
    },
    "contacto_id": {
      "type": "string",
      "description": "ID del Contacto que visita"
    },
    "contacto_nombre": {
      "type": "string",
      "description": "Nombre del contacto, desnormalizado"
    },
    "fecha_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora programada de la visita"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Presencial",
        "Virtual"
      ],
      "default": "Presencial",
      "description": "Modalidad de la visita"
    },
    "duracion_minutos": {
      "type": "number",
      "default": 60,
      "description": "Duraci\u00f3n estimada en minutos"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Solicitada",
        "Programada",
        "Realizada",
        "Cancelada",
        "No_asistio"
      ],
      "default": "Programada",
      "description": "Estado de la visita"
    },
    "preferencia_horario": {
      "type": "string",
      "description": "Cuando le queda bien al cliente, en sus palabras ('el martes por la manana'). El agente NO puede fijar una hora: solo recoge la preferencia y el equipo confirma. Por eso fecha_hora no es obligatoria."
    },
    "origen": {
      "type": "string",
      "description": "Quien creo la visita: 'agente:whatsapp', 'agente:telegram' o 'manual'"
    },
    "fecha_solicitud": {
      "type": "string",
      "format": "date-time",
      "description": "Cuando el cliente la pidio. Distinto de fecha_hora, que es cuando quedo agendada."
    },
    "notas_resultado": {
      "type": "string",
      "description": "Resultado y observaciones tras la visita"
    }
  },
  "required": [
    "propiedad_id",
    "contacto_id"
  ]
}