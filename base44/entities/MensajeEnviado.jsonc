{
  "name": "MensajeEnviado",
  "type": "object",
  "description": "Registro de auditoría de cada mensaje saliente hacia un contacto. Lo escribe la función leadWhatsApp y el motor de plantillas.",
  "properties": {
    "contacto_id": {
      "type": "string",
      "description": "ID del Contacto destinatario"
    },
    "contacto_nombre": {
      "type": "string",
      "description": "Nombre del destinatario, desnormalizado"
    },
    "contacto_telefono": {
      "type": "string",
      "description": "Teléfono destino del envío"
    },
    "canal": {
      "type": "string",
      "enum": ["WhatsApp", "Instagram", "Facebook", "Email"],
      "default": "WhatsApp",
      "description": "Canal usado para el envío"
    },
    "template_id": {
      "type": "string",
      "description": "ID de la MensajeTemplate usada; vacío si fue mensaje libre"
    },
    "template_nombre": {
      "type": "string",
      "description": "Nombre de la plantilla, desnormalizado"
    },
    "contenido_final": {
      "type": "string",
      "description": "Contenido efectivamente enviado, con las variables ya reemplazadas"
    },
    "fecha_envio": {
      "type": "string",
      "format": "date-time",
      "description": "Momento del envío"
    },
    "estado": {
      "type": "string",
      "enum": ["Enviado", "Entregado", "Leido", "Error"],
      "default": "Enviado",
      "description": "Estado de entrega reportado por el proveedor"
    },
    "mensaje_id_externo": {
      "type": "string",
      "description": "ID del mensaje en la API del proveedor (Meta Graph), para conciliar estados"
    },
    "es_automatico": {
      "type": "boolean",
      "default": false,
      "description": "true si lo disparó un trigger, false si lo envió una persona"
    }
  },
  "required": ["contacto_id", "contenido_final"]
}
