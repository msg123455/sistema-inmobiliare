{
  // SIN bloque "automations": Base44 los rechaza en esta app (409
  // workflows_enabled, las automatizaciones legacy estan deshabilitadas) y con
  // eso rechaza la FUNCION ENTERA. Como Publish deploya en lote, estas dos
  // arrastraban al resto: agenteInbound se quedo cinco commits atras sin que
  // nada lo dijera.
  //
  // Lo que hacia el cron (*/5 * * * *): cron_entrega_salida.
  // Hay que rehacerlo como Workflow de Base44. Mientras tanto la entrega va
  // inline en el turno, que es el camino normal; esto solo era la red de
  // seguridad para lo que quedo en ColaSalida.
  "name": "enviarPendientes",
  "entry": "bundle.ts"
}
